# Copy this file to .env and fill it with your own tokens.
# All three are optional for public data: an unset, expired or revoked GitLab
# token only triggers a warning and a fallback to unauthenticated access.

# github.com, classic token with public read access (Github API rate limit).
GITHUB_TOKEN=

# gitlab.com, token with read_api scope.
GITLAB_TOKEN=

# invent.kde.org, token with read_api scope.
GITLAB_KDE_TOKEN=
